<Window x:Class="HoboLibris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HoboLibris.Resources"
        xmlns:h="clr-namespace:HoboLibris.Helpers"
        xmlns:vm="clr-namespace:HoboLibris.ViewModels"
        xmlns:views="clr-namespace:HoboLibris.Views"
        Title="{x:Static res:Strings.App_Title}"
        Height="780"
        Width="1200"
        MinHeight="540"
        MinWidth="860"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <h:EnumEqualsConverter x:Key="EnumEquals"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <h:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </Window.Resources>

    <DockPanel>
        <!-- Title bar: name, main tabs, account, menu -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Image Source="/HoboLibris.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.App_Title}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{x:Static res:Strings.Main_Kobo}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Kobo}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{x:Static res:Strings.Main_Kindle}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Kindle}"/>
                </StackPanel>
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- The Assistant: opens or closes its pane on the right -->
                    <MenuItem Style="{StaticResource RoundedMenuItem}" Command="{Binding Assistant.TogglePaneCommand}"
                              ToolTip="{x:Static res:Strings.Asst_ToggleTip}"
                              AutomationProperties.Name="{x:Static res:Strings.Asst_Title}">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <!-- Language: a globe icon with the languages in a list beneath it, filled in MainWindow.xaml.cs -->
                    <MenuItem x:Name="LanguageMenu" Style="{StaticResource LanguageMenuItem}"
                              ToolTip="{x:Static res:Strings.Menu_Language}"
                              AutomationProperties.Name="{x:Static res:Strings.Menu_Language}">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Style="{StaticResource RoundedMenuItem}" Click="Settings_Click"
                              ToolTip="{x:Static res:Strings.Menu_Settings}"
                              AutomationProperties.Name="{x:Static res:Strings.Menu_Settings}">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Style="{StaticResource RoundedMenuItem}" Click="About_Click">
                        <MenuItem.Header>
                            <TextBlock Text="{x:Static res:Strings.Menu_About}"/>
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                            <Binding Path="IsKoboTab"/>
                            <Binding Path="SignedIn"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <TextBlock Text="{Binding SignedInText}" Style="{StaticResource MutedText}" Margin="0,0,4,0"/>
                    <!-- The eye shows or hides the account's email address (hidden at every start) -->
                    <ToggleButton IsChecked="{Binding ShowEmail}" Margin="0,0,8,0" Width="28" Height="28" Cursor="Hand"
                                  VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                  ToolTip="{Binding EmailToggleText}" AutomationProperties.Name="{Binding EmailToggleText}"
                                  Visibility="{Binding HasEmail, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Box" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="Glyph" Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource BackgroundDeepBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource BackgroundDeepBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button Content="{x:Static res:Strings.Main_SignOut}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SignOutCommand}" Padding="10,4"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <views:Spinner DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource BadText}" MaxWidth="900"/>
                    <Button Content="{x:Static res:Strings.Common_Dismiss}" Style="{StaticResource SmallButton}"
                            Command="{Binding DismissErrorCommand}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}"/>
            </DockPanel>
        </Border>

        <!-- Content, with the Assistant pane on the right when it is open -->
        <Grid x:Name="Layout" SizeChanged="Layout_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PaneColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="16,12,6,12">
                <!-- Kobo tab -->
                <Grid Visibility="{Binding IsKoboTab, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource NavButton}" Content="{x:Static res:Strings.Kobo_BackUpTab}"
                                     IsChecked="{Binding KoboMode, Converter={StaticResource EnumEquals}, ConverterParameter=Backup}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{x:Static res:Strings.Kobo_CollectionsTab}"
                                     ToolTip="{x:Static res:Strings.Kobo_CollectionsTabTip}"
                                     IsChecked="{Binding KoboMode, Converter={StaticResource EnumEquals}, ConverterParameter=Collections}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{Binding SendTabLabel}"
                                     ToolTip="{x:Static res:Strings.Kobo_SendTabTip}"
                                     IsChecked="{Binding KoboMode, Converter={StaticResource EnumEquals}, ConverterParameter=Send}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{x:Static res:Strings.Kobo_ArticlesTab}"
                                     ToolTip="{x:Static res:Strings.Kobo_ArticlesTabTip}"
                                     IsChecked="{Binding KoboMode, Converter={StaticResource EnumEquals}, ConverterParameter=Articles}"/>
                    </StackPanel>
                    <views:KoboBackupView Grid.Row="1" Visibility="{Binding IsBackupMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:CollectionsView Grid.Row="1" Visibility="{Binding IsCollectionsMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:SendView Grid.Row="1" Visibility="{Binding IsSendMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:ArticlesView Grid.Row="1" Visibility="{Binding IsArticlesMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
                <!-- Kindle tab -->
                <views:KindleView Visibility="{Binding IsKindleTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
            <!-- The divider, the pane, and the pane folded to a strip; FoldColumn shows the right ones -->
            <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Style="{StaticResource PanelSplitter}"/>
            <views:AssistantPane x:Name="Pane" Grid.Column="2" DataContext="{Binding Assistant}"/>
            <Button x:Name="PaneStrip" Grid.Column="2" Style="{StaticResource FoldStrip}" Width="30" Margin="0,12,6,12" Click="PaneStrip_Click"
                    ToolTip="{x:Static res:Strings.Asst_Unfold}" AutomationProperties.Name="{x:Static res:Strings.Asst_Unfold}">
                <StackPanel>
                    <Path Data="M5,0 L0,5 L5,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Width="6" Height="10"
                          HorizontalAlignment="Center" Stretch="None"/>
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{x:Static res:Strings.Asst_Title}" Style="{StaticResource StripTitle}"/>
                </StackPanel>
            </Button>
        </Grid>
    </DockPanel>
</Window>
