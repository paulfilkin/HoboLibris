<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<variable name="logDirectory" value="${specialfolder:folder=ApplicationData}/HoboLibris/logs"/>

	<targets>
		<!-- File Target with daily rotation -->
		<target xsi:type="File"
				name="logfile"
				fileName="${logDirectory}/HoboLibris-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}EXCEPTION\: ${exception:format=ToString}}"
				archiveFileName="${logDirectory}/archive/HoboLibris-${shortdate}.{#}.log"
				archiveEvery="Day"
				archiveNumbering="Rolling"
				maxArchiveFiles="7"
				keepFileOpen="false"
				encoding="utf-8" />

		<!-- Console Target for debugging -->
		<target xsi:type="Console"
				name="console"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
	</targets>

	<rules>
		<!-- Write all logs with level Info or higher to file -->
		<logger name="*" minlevel="Info" writeTo="logfile" />

		<!-- Write all logs with level Debug or higher to console (when debugging) -->
		<logger name="*" minlevel="Debug" writeTo="console" />
	</rules>
</nlog>