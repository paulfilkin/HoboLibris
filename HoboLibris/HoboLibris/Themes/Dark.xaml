<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Wayfarer's Bookplate palette, dark: teal-grey pages with vellum text, lighter teal and copper. -->
    <!-- Both palettes define the same brushes; ThemeManager swaps one for the other, and the
         styles use them as DynamicResource so open windows change at once. -->
    <!-- Deep Archival Teal: buttons, the selected tab, links and ticks -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5BBDB5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#74CAC3"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#8FD6D0"/>
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#1E3B3A"/>
    <SolidColorBrush x:Key="PrimaryTintBorderBrush" Color="#2F5856"/>
    <!-- Text and ticks drawn on teal -->
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0B1A1A"/>
    <!-- Copper for the progress bar and spinner -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E8925A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E8925A"/>
    <!-- Copper for the main action button; darker than Accent so its text passes WCAG AA -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#E8925A"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#EFA574"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#F3B88E"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#3A2A1E"/>
    <!-- Text on the copper button -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1F140C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CC48D"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1C3326"/>
    <SolidColorBrush x:Key="SuccessTintBorderBrush" Color="#2E5A3E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F0907E"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F4A797"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#F7BDB1"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#3D2420"/>
    <!-- Text on the red button -->
    <SolidColorBrush x:Key="OnDangerBrush" Color="#1F0E0B"/>
    <!-- Warm Vellum: the window -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#131919"/>
    <SolidColorBrush x:Key="BackgroundDeepBrush" Color="#243030"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2424"/>
    <!-- Every other row in the lists -->
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#202929"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A4847"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECE6DA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6AFAB"/>
</ResourceDictionary>
