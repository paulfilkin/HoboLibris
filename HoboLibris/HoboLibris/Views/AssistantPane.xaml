<UserControl x:Class="HoboLibris.Views.AssistantPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:a="clr-namespace:HoboLibris.Assistant"
             xmlns:views="clr-namespace:HoboLibris.Views">

    <!-- The Assistant: the conversation, approval cards for tools that ask first, and the box to type in.
         The data context is the AssistantViewModel. -->
    <UserControl.Resources>
        <!-- A glyph-only button in the pane's header -->
        <Style x:Key="PaneIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BackgroundDeepBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BackgroundDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The copy icon under each message: smaller than the header's icons. -->
        <Style x:Key="MessageCopyButton" TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- What was sent to a tool and what came back -->
        <Style x:Key="DetailsBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <DataTemplate DataType="{x:Type a:UserMessage}">
            <StackPanel HorizontalAlignment="Right" Margin="40,6,0,6">
                <Border Background="{DynamicResource PrimaryTintBrush}" CornerRadius="10" Padding="11,7,11,8" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                               FlowDirection="{Binding Text, Converter={StaticResource TextFlow}}"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                    <Button Style="{StaticResource MessageCopyButton}" Click="CopyMessage_Click" Margin="0,0,4,0"
                            ToolTip="{x:Static res:Strings.Asst_CopyPromptTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_CopyPromptTip}"/>
                    <TextBlock Text="{Binding Context}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:AssistantMessage}">
            <StackPanel Margin="0,6,0,6">
                <views:ChatText Markdown="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}"
                                FlowDirection="{Binding Text, Converter={StaticResource TextFlow}}"
                                AutomationProperties.Name="{Binding Text}"/>
                <Button Style="{StaticResource MessageCopyButton}" HorizontalAlignment="Left" Margin="-4,2,0,0" Click="CopyMessage_Click"
                        ToolTip="{x:Static res:Strings.Asst_CopyTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_CopyTip}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:NoticeMessage}">
            <DockPanel Margin="0,4,0,4">
                <TextBlock x:Name="Icon" Text="&#xE946;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,2,7,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="Words" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ToolActivity}">
            <Border Background="{DynamicResource BackgroundDeepBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="9,6" Margin="0,3,0,3">
                <StackPanel>
                    <!-- The whole line shows or hides the details -->
                    <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" Focusable="True"
                                  ToolTip="{x:Static res:Strings.Asst_ToolDetailsTip}" AutomationProperties.HelpText="{x:Static res:Strings.Asst_ToolDetailsTip}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <AutomationProperties.Name>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="Title"/>
                                <Binding Path="Summary"/>
                            </MultiBinding>
                        </AutomationProperties.Name>
                        <DockPanel>
                            <TextBlock x:Name="StateIcon" Text="&#xE895;" Style="{StaticResource Glyph}" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Summary}">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Run Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </DockPanel>
                    </ToggleButton>
                    <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock Text="{x:Static res:Strings.Asst_Arguments}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Arguments, Mode=OneWay}" Style="{StaticResource DetailsBox}"
                                 AutomationProperties.Name="{x:Static res:Strings.Asst_Arguments}"/>
                        <TextBlock Text="{x:Static res:Strings.Asst_Result}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBox Text="{Binding Result, Mode=OneWay}" Style="{StaticResource DetailsBox}"
                                 AutomationProperties.Name="{x:Static res:Strings.Asst_Result}"
                                 Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static a:ToolActivityState.Done}">
                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static a:ToolActivityState.Failed}">
                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE7BA;"/>
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static a:ToolActivityState.Declined}">
                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE711;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The books a search found, drawn by HoboLibris: the model needn't list them -->
        <DataTemplate DataType="{x:Type a:SearchResults}">
            <Border Background="{DynamicResource BackgroundDeepBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="9,7,9,7" Margin="0,0,0,3">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Lang"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Col_Title}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Col_Author}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Col_Language}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Shown}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type a:SearchResultRow}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Lang"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Authors}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Language}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Grid Width="24" Height="24">
                                                <Button x:Name="Download" Style="{StaticResource MessageCopyButton}" Content="&#xE896;"
                                                        Command="{Binding DownloadCommand}" ToolTip="{Binding Message}" ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{x:Static res:Strings.Asst_DownloadTip}"
                                                        AutomationProperties.HelpText="{Binding Title}"
                                                        Visibility="{Binding Downloadable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock x:Name="Done" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryBrush}" ToolTip="{Binding Message}" Visibility="Collapsed"
                                                           AutomationProperties.Name="{Binding Message}"/>
                                            </Grid>
                                            <Button Style="{StaticResource MessageCopyButton}" Content="&#xE8A7;" Command="{Binding OpenCommand}"
                                                    ToolTip="{x:Static res:Strings.Asst_OpenPageTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_OpenPageTip}"
                                                    AutomationProperties.HelpText="{Binding Title}"
                                                    IsEnabled="{Binding CanOpen}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static a:SearchRowState.Done}">
                                        <Setter TargetName="Download" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static a:SearchRowState.Downloading}">
                                        <Setter TargetName="Download" Property="Content" Value="&#xE895;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static a:SearchRowState.Failed}">
                                        <Setter TargetName="Download" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ShowAllText}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{Binding ShowEverythingCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ApprovalRequest}">
            <Border x:Name="Card" Background="{DynamicResource BackgroundDeepBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="11,8,11,9" Margin="0,4,0,4">
                <StackPanel>
                    <TextBlock x:Name="Heading" Text="{x:Static res:Strings.Asst_Asked}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    <ToggleButton IsChecked="{Binding IsExpanded}" HorizontalAlignment="Left" Margin="0,4,0,0" Cursor="Hand"
                                  Foreground="{DynamicResource PrimaryBrush}" FontSize="12">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="0,2">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock x:Name="DetailsLabel" Text="{x:Static res:Strings.Asst_ShowDetails}" TextDecorations="Underline"/>
                    </ToggleButton>
                    <TextBox x:Name="Details" Text="{Binding Arguments, Mode=OneWay}" Style="{StaticResource DetailsBox}" Visibility="Collapsed"
                             AutomationProperties.Name="{x:Static res:Strings.Asst_Arguments}"/>
                    <WrapPanel x:Name="Buttons" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button Content="{x:Static res:Strings.Asst_Allow}" Style="{StaticResource ModernButton}" Padding="12,4" Margin="0,0,6,4"
                                Command="{Binding AllowCommand}"/>
                        <Button Content="{x:Static res:Strings.Asst_AlwaysAllow}" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="0,0,6,4"
                                Command="{Binding AlwaysAllowCommand}" ToolTip="{x:Static res:Strings.Asst_AlwaysAllowTip}"
                                Visibility="{Binding CanAlwaysAllow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="{x:Static res:Strings.Asst_Decline}" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="0,0,6,4"
                                Command="{Binding DeclineCommand}"/>
                    </WrapPanel>
                    <TextBlock x:Name="Outcome" Text="{Binding Outcome}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                    <Setter TargetName="Heading" Property="Text" Value="{x:Static res:Strings.Asst_AllowThis}"/>
                    <Setter TargetName="Buttons" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Outcome" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DetailsLabel" Property="Text" Value="{x:Static res:Strings.Asst_HideDetails}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header: title, model, and Copy, New conversation and Close -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource PaneIconButton}" Command="{Binding FoldPaneCommand}"
                                ToolTip="{x:Static res:Strings.Asst_FoldTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_FoldTip}">
                            <Path Data="M0,0 L5,5 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Width="6" Height="10" Stretch="None"/>
                        </Button>
                        <Button Content="&#xE8C8;" Style="{StaticResource PaneIconButton}" Command="{Binding CopyCommand}"
                                ToolTip="{x:Static res:Strings.Asst_CopyConversation}" AutomationProperties.Name="{x:Static res:Strings.Asst_CopyConversation}"/>
                        <Button Content="&#xE710;" Style="{StaticResource PaneIconButton}" Command="{Binding ClearCommand}"
                                ToolTip="{x:Static res:Strings.Asst_NewConversationTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_NewConversation}"/>
                        <Button Content="&#xE711;" Style="{StaticResource PaneIconButton}" Command="{Binding TogglePaneCommand}"
                                ToolTip="{x:Static res:Strings.Asst_CloseTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_Close}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Asst_Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ModelLine}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- No model set up yet: say where to do it -->
            <Border DockPanel.Dock="Top" Style="{StaticResource NoteCard}" Margin="12,10,12,4"
                    Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    Visibility="{Binding IsSetUp, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Menu_Settings}" Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center" Margin="8,0,0,0" Click="Settings_Click"/>
                    <TextBlock Text="{x:Static res:Strings.Asst_SetUpBanner}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>
            </Border>

            <!-- The box to type in, with Send (Stop while a request runs) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding BusyText}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Margin="8,0,0,0"
                            VerticalAlignment="Bottom" Height="36" MinWidth="44" Padding="10,0"
                            Command="{Binding SendOrStopCommand}" ToolTip="{Binding SendToolTip}"
                            AutomationProperties.Name="{Binding SendToolTip}">
                        <TextBlock FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Text" Value="&#xE724;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="56" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="InputBox_PreviewKeyDown"
                             ToolTip="{x:Static res:Strings.Asst_InputTip}" AutomationProperties.Name="{x:Static res:Strings.Asst_InputName}"
                             AutomationProperties.HelpText="{x:Static res:Strings.Asst_InputTip}"/>
                </DockPanel>
            </Border>

            <!-- The conversation -->
            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="14,10,14,14" Focusable="False"/>
                </ScrollViewer>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0" MaxWidth="320"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE8BD;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{x:Static res:Strings.Asst_EmptyHeading}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Static res:Strings.Asst_EmptyText}" Style="{StaticResource HelperText}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
