<UserControl x:Class="HoboLibris.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:h="clr-namespace:HoboLibris.Helpers"
             xmlns:vm="clr-namespace:HoboLibris.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <h:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <Style x:Key="ShowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BackgroundDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryTintBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding Collections}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Coll_Intro}" Style="{StaticResource HelperText}" FontSize="14" Margin="0,0,0,10"/>

        <!-- The eReader is connected: where to eject it after saving -->
        <Border Grid.Row="1" Style="{StaticResource GoodNoteCard}"
                Visibility="{Binding DataContext.ReaderConnected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Command="{Binding DataContext.EjectReaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding DataContext.CanEjectForCollections, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTip="{Binding DataContext.EjectCollectionsHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{x:Static res:Strings.Kobo_EjectReader}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,10 L8,3 L14,10 Z M2,12 L14,12 L14,14 L2,14 Z" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="{x:Static res:Strings.Kobo_EjectReader}"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource GoodText}" Margin="0,0,12,0">
                    <Run Text="✔  "/><Run Text="{x:Static res:Strings.Coll_ConnectedBanner}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Not loaded -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" MaxWidth="700"
                    Visibility="{Binding IsNotLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Style="{StaticResource MutedText}" FontSize="17" TextAlignment="Center">
                <TextBlock.Text>
                    <PriorityBinding>
                        <Binding Path="Error"/>
                        <Binding Source="{x:Static res:Strings.Coll_NoReader}"/>
                    </PriorityBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Command="{Binding DataContext.ReloadCollectionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.Coll_Reload}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Save bar -->
        <WrapPanel Grid.Row="2" Margin="0,2,0,10" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Style="{StaticResource AccentButton}" IsEnabled="{Binding HasPending}" Margin="0,0,6,6" AutomationProperties.Name="{Binding PendingText}"
                    Command="{Binding DataContext.SaveCollectionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding PendingText}"/>
                </StackPanel>
            </Button>
            <Button Content="{x:Static res:Strings.Coll_UndoAll}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding HasPending}"
                    Command="{Binding UndoAllCommand}" Margin="0,0,6,6"/>
            <Button Style="{StaticResource SecondaryButton}" ToolTip="{x:Static res:Strings.Coll_ReloadHint}" Margin="0,0,6,6" AutomationProperties.Name="{x:Static res:Strings.Coll_Reload}"
                    Command="{Binding DataContext.ReloadCollectionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.Coll_Reload}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Error}" Style="{StaticResource BadText}" Margin="8,0,0,6"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Done}" Style="{StaticResource GoodText}" Margin="8,0,0,6"
                       Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </WrapPanel>

        <!-- Two columns: collections on the left, books on the right -->
        <Grid x:Name="ListLayout" Grid.Row="3" SizeChanged="ListLayout_SizeChanged"
              Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The list of collections folded to the left edge -->
            <Button x:Name="ListStrip" Grid.Column="0" Style="{StaticResource FoldStrip}" Click="ListStrip_Click"
                    ToolTip="{x:Static res:Strings.Coll_UnfoldList}" AutomationProperties.Name="{x:Static res:Strings.Coll_UnfoldList}">
                <StackPanel>
                    <Path Data="M0,0 L5,5 L0,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Width="6" Height="10"
                          HorizontalAlignment="Center" Stretch="None"/>
                    <TextBlock Text="{x:Static res:Strings.Kobo_CollectionsTab}" Style="{StaticResource StripTitle}"/>
                </StackPanel>
            </Button>

            <Border x:Name="ListCard" Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FoldButton}" Margin="0,-6,-6,0" Click="FoldList_Click"
                                    ToolTip="{x:Static res:Strings.Coll_FoldList}" AutomationProperties.Name="{x:Static res:Strings.Coll_FoldList}">
                                <Path Data="M5,0 L0,5 L5,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Width="6" Height="10" Stretch="None"/>
                            </Button>
                            <TextBlock Text="{x:Static res:Strings.Coll_Show}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding ShowEntries}" SelectedItem="{Binding SelectedShow}" BorderThickness="0"
                                 Background="Transparent" ItemContainerStyle="{StaticResource ShowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{x:Static res:Strings.Coll_NoneYet}" Margin="10,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CollectionNames.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>
                        <TextBlock Text="{x:Static res:Strings.Coll_NewCollection}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Coll_Create}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CreateCommand}" Margin="6,0,0,0"/>
                            <TextBox Style="{StaticResource SearchBox}" Width="Auto" Tag="{x:Static res:Strings.Coll_NameHint}"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewName_KeyDown"/>
                        </DockPanel>

                        <StackPanel Visibility="{Binding IsCollectionShown, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis">
                                <Run Text="&quot;"/><Run Text="{Binding ShownCollection, Mode=OneWay}"/><Run Text="&quot;"/>
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Coll_Rename}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RenameCommand}" Margin="6,0,0,0"/>
                                <TextBox Style="{StaticResource SearchBox}" Width="Auto" Tag="{x:Static res:Strings.Coll_NewNameHint}"
                                         Text="{Binding RenameTo, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Button x:Name="DeleteButton" Content="{x:Static res:Strings.Coll_DeleteThis}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="DeleteCollection_Click"/>
                            <StackPanel x:Name="ConfirmDelete" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{x:Static res:Strings.Coll_Delete}" Style="{StaticResource DangerButton}" Click="ConfirmDelete_Click" Margin="0,0,6,0"/>
                                    <Button Content="{x:Static res:Strings.Coll_Keep}" Style="{StaticResource SecondaryButton}" Click="KeepCollection_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter x:Name="ListSplitter" Grid.Column="1" Style="{StaticResource PanelSplitter}"/>

            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="{x:Static res:Strings.Kobo_SearchHint}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="0,0,12,0"/>
                    <CheckBox Style="{StaticResource ModernCheckBox}" Content="{x:Static res:Strings.Coll_HideShelved}" IsChecked="{Binding HideShelved}"
                              Visibility="{Binding ShowHideShelved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </WrapPanel>

                <!-- Actions for the ticked books -->
                <Border Grid.Row="1" Background="{DynamicResource BackgroundDeepBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TickedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,12,2"/>
                        <TextBlock x:Name="CollectionLabel" Text="{x:Static res:Strings.Coll_Collection}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Width="220" ItemsSource="{Binding CollectionNames}" SelectedItem="{Binding AddTo}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=CollectionLabel}" Margin="0,0,8,0"/>
                        <Button Content="{x:Static res:Strings.Coll_Move}" Style="{StaticResource ModernButton}" Command="{Binding MoveCommand}"
                                IsEnabled="{Binding CanAct}" ToolTip="{x:Static res:Strings.Coll_MoveHint}" Margin="0,0,6,0"/>
                        <Button Content="{x:Static res:Strings.Coll_AlsoAdd}" Style="{StaticResource SecondaryButton}" Command="{Binding AlsoAddCommand}"
                                IsEnabled="{Binding CanAct}" ToolTip="{x:Static res:Strings.Coll_AlsoAddHint}" Margin="0,0,6,0"/>
                        <Button Content="{Binding RemoveFromText}" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFromShownCommand}"
                                Visibility="{Binding IsCollectionShown, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.IsEnabled>
                                <Binding Path="Ticked" Converter="{StaticResource CountToBool}"/>
                            </Button.IsEnabled>
                        </Button>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="2">
                    <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding VisibleRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ModernCheckBox}" Click="TickAll_Click" ToolTip="{x:Static res:Strings.Coll_TickAll}"
                                                  AutomationProperties.Name="{x:Static res:Strings.Coll_TickAll}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="Tick_Click"
                                                  AutomationProperties.Name="{Binding Title}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Title}" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Author}" Width="180" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Authors}" Style="{StaticResource MutedCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Collections}" Width="240" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding Shelves}" Style="{StaticResource CellText}"
                                                       Visibility="{Binding HasShelves, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{x:Static res:Strings.Coll_None}" Style="{StaticResource MutedCellText}" FontStyle="Italic"
                                                       Visibility="{Binding HasShelves, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Col_From}" Width="90" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FromText}" Style="{StaticResource MutedCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VisibleRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
