<UserControl x:Class="HoboLibris.Views.KindleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:h="clr-namespace:HoboLibris.Helpers"
             xmlns:vm="clr-namespace:HoboLibris.ViewModels"
             xmlns:views="clr-namespace:HoboLibris.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <h:FractionToPercentConverter x:Key="FractionToPercent"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding Kindle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Kindle_Intro}" Style="{StaticResource HelperText}" FontSize="14" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Style="{StaticResource GoodNoteCard}"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Command="{Binding DataContext.KindleEjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding CanEject}" ToolTip="{Binding EjectHint}" AutomationProperties.Name="{Binding EjectText}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,10 L8,3 L14,10 Z M2,12 L14,12 L14,14 L2,14 Z" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="{Binding EjectText}"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource GoodText}" Margin="0,0,12,0">
                    <Run Text="✔  "/><Run Text="{x:Static res:Strings.Kindle_ConnectedNote}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,2,0,6">
            <Button Style="{StaticResource SecondaryButton}"
                    Command="{Binding DataContext.KindleLookAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding Scanning, Converter={StaticResource InverseBool}}"
                    ToolTip="{x:Static res:Strings.Kindle_LookAgainHint}" Margin="0,0,6,6"
                    AutomationProperties.Name="{x:Static res:Strings.Kindle_LookAgain}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.Kindle_LookAgain}"/>
                </StackPanel>
            </Button>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4,10,10"/>
            <Button Style="{StaticResource AccentButton}" IsEnabled="{Binding CanBackUpAll}" Margin="0,0,6,6" AutomationProperties.Name="{Binding BackUpAllText}"
                    Command="{Binding DataContext.KindleBackUpAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬇" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding BackUpAllText}"/>
                </StackPanel>
            </Button>
            <Button Content="{Binding BackUpSelectedText}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanBackUpSelected}" Margin="0,0,6,6"
                    Command="{Binding DataContext.KindleBackUpSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4,10,10"/>
            <Button Content="{x:Static res:Strings.Kobo_OpenFolder}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                    Command="{Binding DataContext.OpenKindleFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{x:Static res:Strings.Kobo_FolderLabel}" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding DataContext.KindleFolder, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MonoText}"/>
        </StackPanel>

        <TextBox Grid.Row="4" Style="{StaticResource SearchBox}" Tag="{x:Static res:Strings.Kobo_SearchHint}" HorizontalAlignment="Left" Margin="0,0,0,10"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

        <Border Grid.Row="5" Style="{StaticResource TealNoteCard}" Padding="12,10"
                Visibility="{Binding Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding Progress.Text}" Margin="0,0,0,6"/>
                <ProgressBar Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"
                             Value="{Binding Progress.Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <!-- Nothing found yet -->
            <StackPanel MaxWidth="760" VerticalAlignment="Top" Margin="0,30,0,0"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding ShowWaiting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource HeadingText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="20">
                        <TextBlock Text="{Binding EmptyText}" FontSize="15" TextWrapping="Wrap" LineHeight="24"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <views:Spinner Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.Device_CheckingAgain}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding NoBooksText}" Style="{StaticResource MutedText}" FontSize="17" HorizontalAlignment="Center"
                           Visibility="{Binding ShowWaiting, Converter={StaticResource InverseBoolToVisibility}}"/>
            </StackPanel>

            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding VisibleRows}"
                      Visibility="{Binding HasBooks, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Click="SelectAll_Click" ToolTip="{x:Static res:Strings.Col_SelectAll}" AutomationProperties.Name="{x:Static res:Strings.Col_SelectAll}"
                                          IsChecked="{Binding DataContext.Kindle.AllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Title}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Title}" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Location}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Author}" Width="200" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Authors}" Style="{StaticResource MutedCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Format}" Width="90" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Format}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_FoundOn}" Width="150" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FromText}" Style="{StaticResource MutedCellText}" ToolTip="{Binding FromToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_BackedUp}" Width="230" MinWidth="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:RowStatusCell/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
