<UserControl x:Class="HoboLibris.Views.KoboBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:h="clr-namespace:HoboLibris.Helpers"
             xmlns:vm="clr-namespace:HoboLibris.ViewModels"
             xmlns:views="clr-namespace:HoboLibris.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <h:EnumEqualsConverter x:Key="EnumEquals"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <h:FractionToPercentConverter x:Key="FractionToPercent"/>
    </UserControl.Resources>

    <Grid>
        <!-- Signed out and no eReader: the welcome card -->
        <Border Style="{StaticResource Card}" MaxWidth="560" VerticalAlignment="Top" Margin="0,60,0,0" Padding="28"
                Visibility="{Binding ShowSignedOutCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Welcome_Heading}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{x:Static res:Strings.Welcome_Text1}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" FontSize="14"/>
                <TextBlock Text="{x:Static res:Strings.Welcome_Text2}" Style="{StaticResource HelperText}"
                           TextAlignment="Center" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="{x:Static res:Strings.Welcome_SignIn}" Style="{StaticResource AccentButton}"
                            FontSize="16" Padding="36,10" Command="{Binding SignInCommand}"
                            IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"/>
                    <views:Spinner Margin="12,0,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <Expander Header="{x:Static res:Strings.Welcome_DidntComeBack}" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{x:Static res:Strings.Welcome_PasteHint}" Style="{StaticResource HelperText}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,6"
                                 Text="{Binding PasteLink, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="{x:Static res:Strings.Welcome_UseLink}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Command="{Binding SignInWithLinkCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- The list -->
        <Grid Visibility="{Binding ShowSignedOutCard, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Banners -->
            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource NoteCard}"
                        Visibility="{Binding ShowSignInBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <views:Spinner DockPanel.Dock="Right" Margin="10,0,0,0"
                                       Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Kobo_SignIn}" Style="{StaticResource AccentButton}"
                                Command="{Binding SignInCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{x:Static res:Strings.Kobo_SignInBanner}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoteCard}"
                        Visibility="{Binding ShowSendWaitingNote, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Kobo_SeeAndSend}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowSendScreenCommand}"/>
                        <TextBlock Text="{Binding SendWaitingText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource GoodNoteCard}"
                        Visibility="{Binding ReaderConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding EjectReaderCommand}"
                                IsEnabled="{Binding CanEjectReader}" ToolTip="{x:Static res:Strings.Kobo_EjectReaderHint}"
                                AutomationProperties.Name="{x:Static res:Strings.Kobo_EjectReader}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,10 L8,3 L14,10 Z M2,12 L14,12 L14,14 L2,14 Z" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"/>
                                <TextBlock Text="{x:Static res:Strings.Kobo_EjectReader}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource GoodText}" Margin="0,0,12,0">
                            <Run Text="✔  "/><Run Text="{x:Static res:Strings.Kobo_ReaderConnectedNote}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding ReaderNoteText}" Style="{StaticResource HelperText}" FontSize="14" Margin="0,0,0,8"
                           Visibility="{Binding ShowReaderWaitingNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="1" Margin="0,2,0,6">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshListCommand}"
                        IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                        ToolTip="{x:Static res:Strings.Kobo_RefreshListHint}" Margin="0,0,6,6"
                        AutomationProperties.Name="{x:Static res:Strings.Kobo_RefreshList}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static res:Strings.Kobo_RefreshList}"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4,10,10"/>
                <Button Style="{StaticResource AccentButton}" Command="{Binding BackUpAllCommand}"
                        IsEnabled="{Binding CanBackUpAll}" Margin="0,0,6,6"
                        AutomationProperties.Name="{Binding BackUpAllText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontSize="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding BackUpAllText}"/>
                    </StackPanel>
                </Button>
                <Button Content="{Binding BackUpSelectedText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackUpSelectedCommand}" IsEnabled="{Binding CanBackUpSelected}" Margin="0,0,6,6"/>
                <Button Content="{Binding DeleteSelectedText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDelete}"
                        ToolTip="{x:Static res:Strings.Kobo_DeleteSelectedHint}" Margin="0,0,6,6"/>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4,10,10"/>
                <Button Content="{x:Static res:Strings.Kobo_OpenFolder}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenKoboFolderCommand}" Margin="0,0,6,6"/>
            </WrapPanel>

            <!-- Folder -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:Strings.Kobo_FolderLabel}" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding KoboFolder}" Style="{StaticResource MonoText}"/>
            </StackPanel>

            <!-- Search and sort -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Style="{StaticResource SearchBox}" Tag="{x:Static res:Strings.Kobo_SearchHint}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                <TextBlock Text="{x:Static res:Strings.Kobo_SortBy}" Style="{StaticResource MutedText}" Margin="16,0,8,0"/>
                <RadioButton Style="{StaticResource PillButton}" Content="{x:Static res:Strings.Kobo_SortTitle}"
                             IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Title}"/>
                <RadioButton Style="{StaticResource PillButton}" Content="{x:Static res:Strings.Kobo_SortAuthor}"
                             IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Author}"/>
            </StackPanel>

            <!-- Progress -->
            <Border Grid.Row="4" Style="{StaticResource TealNoteCard}" Padding="12,10"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,6"/>
                    <ProgressBar Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}"/>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Grid Grid.Row="5">
                <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding KoboRows}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="AllBox" Style="{StaticResource ModernCheckBox}" Click="SelectAll_Click"
                                              ToolTip="{x:Static res:Strings.Col_SelectAll}" AutomationProperties.Name="{x:Static res:Strings.Col_SelectAll}"
                                              IsChecked="{Binding DataContext.AllKoboSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Title}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Title}" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Location}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Author}" Width="220" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Authors}" Style="{StaticResource MutedCellText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Format}" Width="90" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Format}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="150" MinWidth="110">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{x:Static res:Strings.Col_From}" ToolTip="{x:Static res:Strings.Col_FromTip}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FromText}" ToolTip="{Binding FromToolTip}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStoreFree}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Col_OnThisComputer}" Width="230" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <views:RowStatusCell/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding KoboEmptyText}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KoboRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
