<UserControl x:Class="HoboLibris.Views.PreviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:vm="clr-namespace:HoboLibris.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- The store previews on the eReader, and the wishlist in the Kobo account (#59) -->
    <Grid DataContext="{Binding Previews}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Prev_Intro}" Style="{StaticResource HelperText}" FontSize="14" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Style="{StaticResource NoteCard}" Visibility="{Binding ShowNoReader, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static res:Strings.Prev_NoReader}" TextWrapping="Wrap"/>
        </Border>

        <!-- Previews -->
        <WrapPanel Grid.Row="2" Margin="0,2,0,6">
            <TextBlock Text="{x:Static res:Strings.Prev_Heading}" Style="{StaticResource HeadingText}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,6"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddTickedToWishlistCommand}" IsEnabled="{Binding CanAddWish}" Margin="0,0,6,6"
                    Content="{Binding AddWishText}" ToolTip="{x:Static res:Strings.Prev_AddHint}" AutomationProperties.Name="{Binding AddWishText}"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding LookAgainCommand}" ToolTip="{x:Static res:Strings.Prev_LookAgainHint}" Margin="0,0,12,6"
                    AutomationProperties.Name="{x:Static res:Strings.Send_LookAgain}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.Send_LookAgain}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Error}" Style="{StaticResource BadText}" VerticalAlignment="Center" Margin="0,0,0,6"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Done}" Style="{StaticResource GoodText}" VerticalAlignment="Center" Margin="0,0,0,6"
                       Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </WrapPanel>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Click="TickAll_Click" ToolTip="{x:Static res:Strings.Coll_TickAll}"
                                          AutomationProperties.Name="{x:Static res:Strings.Coll_TickAll}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding Title}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Title}" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Title}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Author}" Width="160" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Author}" Style="{StaticResource MutedCellText}" ToolTip="{Binding Author}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Arrived}" Width="95" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ArrivedText}" Style="{StaticResource MutedCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Size}" Width="80" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Wish_Heading}" Width="250" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WishText}" Style="{StaticResource MutedCellText}" ToolTip="{Binding WishText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="130" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CellText}" ToolTip="{x:Static res:Strings.Prev_StoreHint}">
                                    <Hyperlink Command="{Binding DataContext.Previews.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Foreground="{DynamicResource PrimaryBrush}">
                                        <Run Text="{x:Static res:Strings.Prev_OpenStore}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyText}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Wishlist -->
        <WrapPanel Grid.Row="4" Margin="0,2,0,6">
            <TextBlock Text="{x:Static res:Strings.Wish_Heading}" Style="{StaticResource HeadingText}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,6"/>
            <TextBlock Text="{x:Static res:Strings.Wish_Intro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,6"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveTickedFromWishlistCommand}" IsEnabled="{Binding CanRemoveWish}" Margin="0,0,12,6"
                    Content="{Binding RemoveWishText}" ToolTip="{x:Static res:Strings.Wish_RemoveHint}" AutomationProperties.Name="{Binding RemoveWishText}"/>
            <TextBlock Text="{x:Static res:Strings.Wish_NeedsReader}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,6"
                       Visibility="{Binding ShowWishNeedsReader, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding WishError}" Style="{StaticResource BadText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,6"
                       Visibility="{Binding HasWishError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding WishDone}" Style="{StaticResource GoodText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,6"
                       Visibility="{Binding HasWishDone, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </WrapPanel>

        <Grid Grid.Row="5">
            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding WishRows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Click="TickAllWish_Click" ToolTip="{x:Static res:Strings.Coll_TickAll}"
                                          AutomationProperties.Name="{x:Static res:Strings.Coll_TickAll}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanTick}" AutomationProperties.Name="{Binding Title}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Title}" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Title}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Author}" Width="160" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Author}" Style="{StaticResource MutedCellText}" ToolTip="{Binding Author}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Added}" Width="95" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddedText}" Style="{StaticResource MutedCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Price}" Width="150" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriceText}" Style="{StaticResource MutedCellText}" ToolTip="{Binding PriceText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="250" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemovingText}" Style="{StaticResource MutedCellText}" ToolTip="{Binding RemovingText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="130" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CellText}" ToolTip="{x:Static res:Strings.Prev_StoreHint}">
                                    <Hyperlink Command="{Binding DataContext.Previews.OpenWishPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Foreground="{DynamicResource PrimaryBrush}">
                                        <Run Text="{x:Static res:Strings.Prev_OpenStore}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding WishEmptyText}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WishRows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
