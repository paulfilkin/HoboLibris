<UserControl x:Class="HoboLibris.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HoboLibris.Resources"
             xmlns:h="clr-namespace:HoboLibris.Helpers"
             xmlns:vm="clr-namespace:HoboLibris.ViewModels"
             xmlns:models="clr-namespace:HoboLibris.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <h:FractionToPercentConverter x:Key="FractionToPercent"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Send_Intro}" Style="{StaticResource HelperText}" FontSize="14" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource GoodNoteCard}" Visibility="{Binding ReaderConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding EjectReaderCommand}"
                            IsEnabled="{Binding Send.Sending, Converter={StaticResource InverseBool}}" ToolTip="{x:Static res:Strings.Send_EjectHint}"
                            AutomationProperties.Name="{x:Static res:Strings.Kobo_EjectReader}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,10 L8,3 L14,10 Z M2,12 L14,12 L14,14 L2,14 Z" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"/>
                            <TextBlock Text="{x:Static res:Strings.Kobo_EjectReader}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource GoodText}">
                        <Run Text="✔  "/><Run Text="{x:Static res:Strings.Send_ReaderConnected}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource NoteCard}" Visibility="{Binding ReaderConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.Send_PlugIn}" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,2,0,6">
            <Button Style="{StaticResource AccentButton}" Command="{Binding SendAllReadyCommand}" Margin="0,0,6,6"
                    AutomationProperties.Name="{Binding ReadyToSend, StringFormat={x:Static res:Strings.Send_AllReady}}">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="ReaderConnected"/>
                        <Binding Path="Send.Sending" Converter="{StaticResource InverseBool}"/>
                        <Binding Path="ReadyToSend" Converter="{StaticResource CountToBool}"/>
                    </MultiBinding>
                </Button.IsEnabled>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬆" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ReadyToSend, StringFormat={x:Static res:Strings.Send_AllReady}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding SendSelectedCommand}" Margin="0,0,6,6"
                    Content="{Binding Send.SelectedCount}" ContentStringFormat="{x:Static res:Strings.Send_Selected}"
                    AutomationProperties.Name="{Binding Send.SelectedCount, StringFormat={x:Static res:Strings.Send_Selected}}">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="ReaderConnected"/>
                        <Binding Path="Send.Sending" Converter="{StaticResource InverseBool}"/>
                        <Binding Path="Send.SelectedCount" Converter="{StaticResource CountToBool}"/>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding LookAgainSendCommand}" ToolTip="{x:Static res:Strings.Send_LookAgainHint}" Margin="0,0,6,6"
                    AutomationProperties.Name="{x:Static res:Strings.Send_LookAgain}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Static res:Strings.Send_LookAgain}"/>
                </StackPanel>
            </Button>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4,10,10"/>
            <CheckBox Style="{StaticResource ModernCheckBox}" Content="{x:Static res:Strings.Send_Auto}" ToolTip="{x:Static res:Strings.Send_AutoHint}"
                      IsChecked="{Binding AutoSend}" Margin="0,0,0,6"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.Send_KoboFolder}" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding KoboFolder}" Style="{StaticResource MonoText}"/>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource TealNoteCard}" Padding="12,10"
                Visibility="{Binding Send.Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding Send.Progress.Text}" Margin="0,0,0,6"/>
                <ProgressBar Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"
                             Value="{Binding Send.Progress.Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Send.Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Click="SelectAll_Click" ToolTip="{x:Static res:Strings.Send_TickAll}" AutomationProperties.Name="{x:Static res:Strings.Send_TickAll}"
                                          IsChecked="{Binding DataContext.Send.AllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding FileName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_BookFile}" Width="*" MinWidth="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource CellText}" ToolTip="{Binding Path}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Format}" Width="90" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Format}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_OnReader}" Width="290" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:Strings.Row_Waiting}" Style="{StaticResource MutedText}"
                                               Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <ProgressBar Style="{StaticResource ModernProgressBar}" Width="150" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{x:Static res:Strings.Send_Sent}" Style="{StaticResource GoodText}" ToolTip="{x:Static res:Strings.Send_SentTip}"
                                               Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{x:Static res:Strings.Row_Failed}" Style="{StaticResource BadText}" ToolTip="{Binding Error}"
                                               Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Verdict.Label}" ToolTip="{Binding Verdict.Why}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding ShowVerdict, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:VerdictKind.Ready}">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:VerdictKind.OnReader}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:VerdictKind.Protected}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:VerdictKind.NotKobo}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{Binding SendButtonText}" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.SendRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding ShowSendButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{x:Static res:Strings.Send_NoFiles}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Send.Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
