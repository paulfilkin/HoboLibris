<Window x:Class="HoboLibris.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HoboLibris.Resources"
        Title="{x:Static res:Strings.About_Title}"
        Height="440"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="AboutSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="AboutText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: branding -->
        <StackPanel Grid.Column="0" Width="180">
            <Image Source="/multifarious.png" Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static res:Strings.About_Production}"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
            <Image Source="/HoboLibris.png" Width="72" Height="72" Margin="0,0,0,12" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static res:Strings.App_Title}"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="12,0"/>

        <!-- Right: content -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.About_AboutHeader}" Style="{StaticResource AboutSectionHeader}" Margin="0,0,0,6"/>
                <TextBlock Text="{x:Static res:Strings.About_Description}" Style="{StaticResource AboutText}"/>

                <TextBlock Text="{x:Static res:Strings.About_DataHeader}" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Text="{x:Static res:Strings.About_DataText}" Style="{StaticResource AboutText}"/>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink Click="OpenDataFolder_Click" Foreground="{StaticResource PrimaryBrush}">
                        <Run x:Name="DataFolderRun"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{x:Static res:Strings.About_SupportHeader}" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Text="{x:Static res:Strings.About_SupportText}" Style="{StaticResource AboutText}" Margin="0,0,0,6"/>
                <TextBlock Margin="0,0,0,6">
                    <Hyperlink NavigateUri="https://multifarious.filkin.com/support"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="{x:Static res:Strings.About_SupportUrl}"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock x:Name="CopyrightText" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,16,0,12"/>

                <Button Content="{x:Static res:Strings.Common_Close}" Style="{StaticResource ModernButton}"
                        Width="100" HorizontalAlignment="Left" Click="CloseButton_Click" IsCancel="True"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
