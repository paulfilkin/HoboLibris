<Window x:Class="HoboLibris.Windows.DeleteBooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HoboLibris.Resources"
        Title="{x:Static res:Strings.Delete_WindowTitle}"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" Style="{StaticResource HeadingText}" Margin="0,0,0,12"/>
        <TextBlock x:Name="CopiesText" TextWrapping="Wrap" FontSize="14"/>
        <StackPanel x:Name="ReaderPanel" Margin="0,12,0,0">
            <CheckBox x:Name="RemoveBox" Style="{StaticResource ModernCheckBox}" FontWeight="SemiBold" Click="RemoveBox_Click"/>
            <TextBlock x:Name="RemoveNote" Style="{StaticResource HelperText}" Margin="24,4,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StoreNote" Style="{StaticResource HelperText}" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="DeleteButton" Content="{x:Static res:Strings.Delete_Button}" Style="{StaticResource DangerButton}"
                    MinWidth="100" Click="Delete_Click" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
