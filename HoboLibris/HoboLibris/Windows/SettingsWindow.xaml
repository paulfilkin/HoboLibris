<Window x:Class="HoboLibris.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HoboLibris.Resources"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="720"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <!-- The data context is the main view model: every change takes effect straight away, as the
         folder buttons on the main screens did. -->
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- A folder path that can be selected and copied, but not typed into. -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- Paths read left to right in every language. -->
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Kobo -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Main_Kobo}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="KoboFolderLabel" Text="{x:Static res:Strings.Settings_BooksFolder}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_KoboFolderHint}" Style="{StaticResource FieldHint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathBox}" Text="{Binding KoboFolder, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=KoboFolderLabel}"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Change}" Style="{StaticResource RowButton}"
                                    Command="{Binding ChooseKoboFolderCommand}" ToolTip="{x:Static res:Strings.Kobo_SaveToHint}"/>
                            <Button Grid.Column="2" Content="{x:Static res:Strings.Kobo_OpenFolder}" Style="{StaticResource RowButton}"
                                    Command="{Binding OpenKoboFolderCommand}" Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kindle -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Main_Kindle}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="KindleFolderLabel" Text="{x:Static res:Strings.Settings_BooksFolder}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_KindleFolderHint}" Style="{StaticResource FieldHint}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathBox}" Text="{Binding KindleFolder, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=KindleFolderLabel}"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Change}" Style="{StaticResource RowButton}"
                                    Command="{Binding ChooseKindleFolderCommand}" ToolTip="{x:Static res:Strings.Kindle_SaveToHint}"/>
                            <Button Grid.Column="2" Content="{x:Static res:Strings.Kobo_OpenFolder}" Style="{StaticResource RowButton}"
                                    Command="{Binding OpenKindleFolderCommand}" Margin="0"/>
                        </Grid>

                        <TextBlock Text="{x:Static res:Strings.Settings_ExtraFolders}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{x:Static res:Strings.Kindle_AddFolderHint}" Style="{StaticResource FieldHint}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_NoExtraFolders}" Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                   Visibility="{Binding HasKindleExtraFolders, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding KindleExtraFolders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource PathBox}" Text="{Binding Mode=OneWay}"/>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Remove}" Style="{StaticResource SmallButton}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveKindleFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" AutomationProperties.HelpText="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{x:Static res:Strings.Settings_Add}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Command="{Binding KindleAddFolderCommand}" ToolTip="{x:Static res:Strings.Kindle_AddFolderHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- eReader book-list backups -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="BackupFolderLabel" Text="{x:Static res:Strings.Settings_BackupsHeader}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_BackupsHint}" Style="{StaticResource FieldHint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathBox}" Text="{Binding BackupFolder, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=BackupFolderLabel}"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Change}" Style="{StaticResource RowButton}"
                                    Command="{Binding ChooseBackupFolderCommand}" ToolTip="{x:Static res:Strings.Dialog_ChooseBackupFolder}"/>
                            <Button Grid.Column="2" Content="{x:Static res:Strings.Kobo_OpenFolder}" Style="{StaticResource RowButton}"
                                    Command="{Binding OpenBackupFolderCommand}" Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="{x:Static res:Strings.Common_Close}" Style="{StaticResource ModernButton}"
                Width="100" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CloseButton_Click" IsCancel="True"/>
    </Grid>
</Window>
