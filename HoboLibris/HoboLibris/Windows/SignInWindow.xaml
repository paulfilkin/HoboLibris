<Window x:Class="HoboLibris.Windows.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HoboLibris.Resources"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{x:Static res:Strings.SignIn_Title}"
        Height="780"
        Width="580"
        MinHeight="500"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,8">
            <TextBlock x:Name="NoteText" Text="{x:Static res:Strings.SignIn_Note}" Style="{StaticResource HelperText}"/>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
        <Border x:Name="ErrorPanel" Grid.Row="1" Style="{StaticResource Card}" Margin="24" VerticalAlignment="Top"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.SignIn_WebViewMissing}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock>
                    <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                               RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="{x:Static res:Strings.SignIn_WebViewLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="ErrorDetail" Style="{StaticResource HelperText}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
